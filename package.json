{
  "name": "cma-passq-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:tier1-2": "playwright test tests/e2e/auth.spec.ts tests/e2e/design-shell.spec.ts tests/e2e/dashboard.spec.ts tests/e2e/roadmap.spec.ts tests/e2e/quiz-practice.spec.ts tests/e2e/srs-review.spec.ts tests/e2e/exam-simulation.spec.ts tests/e2e/formulas.spec.ts",
    "test:tier3": "playwright test tests/e2e/pairwise.spec.ts",
    "test:tier4": "playwright test tests/e2e/scenarios.spec.ts",
    "test:all": "vitest run && playwright test",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:ingest": "python scripts/ingest_cma_qbank.py",
    "db:verify": "python scripts/verify_ingestion.py"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.1",
